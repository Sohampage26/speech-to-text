# Neon pooled connection string (use sslmode=require)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-transcribe-live
# chunked = standard Gemini API (works on any key); live = Gemini Live API
STT_PROVIDER=chunked
GEMINI_STT_MODEL=gemini-3.8-flash
